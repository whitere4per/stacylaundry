:root {
  --bg: #f4f7fb; --panel: #ffffff; --text: #1d2636; --muted: #62708a; --line: #e4eaf2; --primary: #214a80; --primary-soft: #dfeaff; --success: #228a5d; --warning: #d49b1a; --danger: #bf3b3b; --info: #2a7ae2; --shadow: 0 8px 24px rgba(28, 43, 64, 0.08);
}
* { box-sizing: border-box; }
body { margin: 0; font-family: Arial, Helvetica, sans-serif; background: var(--bg); color: var(--text); }
.container { max-width: 1200px; margin: 0 auto; padding: 32px 20px; }
.topbar { background: #fff; border-bottom: 1px solid var(--line); }
.navbar { display:flex; justify-content:space-between; align-items:center; padding: 16px 20px; }
.brand { font-size: 1.6rem; font-weight: 700; color: var(--primary); }
.system-grid { display:grid; grid-template-columns: repeat(auto-fit,minmax(250px,1fr)); gap: 20px; }
.card { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow); padding: 20px; }
.card h3 { margin-top:0; }
.system-link { display:inline-block; background: var(--primary); color:#fff; text-decoration:none; padding:10px 14px; border-radius: 10px; }
.auth-shell { max-width: 460px; margin: 80px auto; background: #fff; border:1px solid var(--line); border-radius: 16px; box-shadow: var(--shadow); padding: 28px; }
label { display:block; margin-bottom: 6px; font-weight: 600; }
input, select, textarea { width:100%; padding: 10px 12px; margin-bottom: 16px; border:1px solid var(--line); border-radius: 8px; background:#fff; }
button, .btn { display:inline-block; background: var(--primary); color:#fff; padding:10px 16px; border:none; border-radius: 8px; cursor:pointer; text-decoration:none; }
.btn.secondary { background:#eef3fb; color:var(--text); }
.btn.success { background:var(--success); }
.btn.warning { background:var(--warning); }
.btn.danger { background:var(--danger); }
.dashboard-grid { display:grid; grid-template-columns: repeat(auto-fit,minmax(180px,1fr)); gap: 18px; }
.stat-card { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow); padding: 18px; }
.stat-card .label { color: var(--muted); font-size:0.8rem; text-transform: uppercase; letter-spacing: 0.08em; }
.stat-card .value { font-size:2rem; font-weight:700; margin: 12px 0 0; }
.table-wrap { overflow:auto; }
table { width:100%; border-collapse: collapse; background:#fff; }
th, td { padding: 12px 10px; border-bottom: 1px solid var(--line); text-align:left; }
th { background:#f9fbff; }
.alert { padding:12px 14px; border-radius: 10px; margin-bottom:18px; }
.alert.success { background:#eafaf1; color:#1c6d48; }
.alert.error { background:#fdeeee; color:#a63c3c; }
.row { display:flex; gap: 16px; flex-wrap: wrap; }
.layout { display:flex; min-height:100vh; }
.sidebar { width: 260px; background: #12263d; color:#fff; padding: 18px 16px; }
.sidebar .brand { color:#fff; display:block; margin-bottom:20px; }
.nav a { display:block; padding: 11px 12px; color:#dfe8f5; text-decoration:none; border-radius: 8px; margin-bottom:4px; }
.nav a.active { background: rgba(255,255,255,0.12); }
.main { flex:1; padding: 18px; }
.content-card { background:#fff; border:1px solid var(--line); border-radius: 12px; padding: 18px; box-shadow: var(--shadow); }
.status-badge { display:inline-block; padding:4px 8px; border-radius:999px; font-size:0.72rem; font-weight:700; }
.status-received { background:#eef3ff; color:#234f9d; }
.status-washing { background:#fff1d3; color:#8c5d00; }
.status-drying { background:#e1f7f0; color:#1a7a60; }
.status-folding { background:#f0eaff; color:#6146a1; }
.status-ready { background:#e1f9e5; color:#1b7d42; }
.status-picked { background:#d9f3ff; color:#0b7090; }
.status-cancelled { background:#fdd8d8; color:#9c2f2f; }
.app-grid { display:grid; grid-template-columns: repeat(auto-fit,minmax(220px,1fr)); gap: 16px; }
.market-layout { display:grid; gap:10px; grid-template-columns: repeat(auto-fit,minmax(120px,1fr)); }
.stall { border:1px solid var(--line); padding:12px; border-radius:10px; background:#f9fbff; min-height:92px; }
.stall.green { background:#dff7eb; border-color:#9fd7b9; }
.stall.gray { background:#eef1f5; }
.stall.yellow { background:#fff5d6; border-color:#f1d277; }
.stall.red { background:#fde4e4; border-color:#e49d9d; }
.legend { display:flex; gap:10px; flex-wrap: wrap; }
.legend .item { display:flex; align-items:center; gap:8px; }
.legend .swatch { width:16px; height:16px; border-radius:4px; }
.dashboard-shell { display:flex; flex-direction:column; gap:22px; }
.dashboard-header { display:flex; justify-content:space-between; align-items:center; gap:16px; margin-bottom:4px; }
.eyebrow { font-size:0.78rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:var(--muted); }
.dashboard-header h1 { margin:8px 0 0; font-size:2.2rem; letter-spacing:-0.04em; }
.dashboard-tools { display:flex; align-items:center; gap:12px; }
.soft-btn, .primary-btn { border:none; border-radius:10px; padding:10px 14px; font-weight:700; cursor:pointer; }
.soft-btn { background:#eef4ff; color:var(--primary); }
.primary-btn { background:#3658b5; color:#fff; box-shadow:0 10px 20px rgba(54,88,181,0.18); }
.kpi-grid { display:grid; grid-template-columns:repeat(4, minmax(180px, 1fr)); gap:16px; }
.kpi-card { background:linear-gradient(180deg, #ffffff, #f7f9ff); border:1px solid var(--line); border-radius:16px; padding:18px 18px 16px; box-shadow:var(--shadow); }
.kpi-card.blue { background:linear-gradient(180deg, #eef3ff, #f9fbff); }
.kpi-head { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:18px; }
.kpi-label { color:var(--muted); font-weight:600; }
.kpi-value { font-size:2rem; font-weight:800; letter-spacing:-0.04em; }
.kpi-meta { color:var(--muted); font-size:0.8rem; margin-top:8px; }
.trend-up, .trend-down, .trend-neutral { font-size:0.72rem; font-weight:700; border-radius:999px; padding:5px 8px; }
.trend-up { background:#eafaf1; color:#1e7a4d; }
.trend-down { background:#fff0ef; color:#b44a42; }
.trend-neutral { background:#eef3ff; color:#3253b0; }
.main-grid { display:grid; grid-template-columns: minmax(0, 2fr) minmax(260px, 0.9fr); gap:16px; }
.panel { background:#fff; border:1px solid var(--line); border-radius:16px; padding:18px; box-shadow:var(--shadow); }
.panel-head { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:16px; }
.panel-head h3 { margin:0; font-size:1.15rem; }
.panel-head a { color:var(--primary); text-decoration:none; font-weight:700; }
.soft-badge { display:inline-flex; align-items:center; justify-content:center; padding:5px 9px; border-radius:999px; background:#edf5ff; color:#2e5ad8; font-size:0.72rem; font-weight:700; }
.soft-badge.subtle { background:#f3f5f9; color:var(--muted); }
.table-wrap { overflow:auto; }
.data-table { width:100%; border-collapse:collapse; }
.data-table th, .data-table td { padding:12px 10px; text-align:left; border-bottom:1px solid var(--line); }
.data-table th { background:#f7f9ff; color:var(--muted); font-size:0.78rem; letter-spacing:0.05em; text-transform:uppercase; }
.data-table tbody tr:hover { background:#f9fbff; }
.transaction-list { display:flex; flex-direction:column; gap:12px; }
.transaction-item { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px; border:1px solid var(--line); border-radius:12px; background:#f9fbff; }
.transaction-item strong { display:block; font-size:0.95rem; }
.transaction-item small { color:var(--muted); display:block; margin-top:2px; }
.amount { font-weight:800; }
.amount.positive { color:#1f7d54; }
.bottom-grid { display:grid; grid-template-columns:repeat(2, minmax(280px, 1fr)); gap:16px; }
.mini-bars { display:flex; flex-direction:column; gap:18px; }
.bar-row { display:grid; grid-template-columns:80px 1fr 42px; align-items:end; gap:12px; font-size:0.84rem; color:var(--muted); }
.mini-track { height:74px; display:flex; align-items:flex-end; background:linear-gradient(180deg, #f1f4fa, #eef5ff); border-radius:10px; overflow:hidden; border:1px solid var(--line); }
.mini-track i { display:block; width:100%; height:0; border-radius:8px 8px 0 0; background:linear-gradient(180deg, #9bbaef, #4d72d7); }
.bar-row strong { color:var(--text); font-size:0.92rem; }
.status-stack { display:grid; gap:12px; }
.status-chip { display:flex; align-items:center; gap:10px; padding:12px 14px; border:1px solid var(--line); border-radius:12px; background:#f9fbff; font-weight:600; }
.status-chip strong { margin-left:auto; }
.dot { width:10px; height:10px; border-radius:50%; display:inline-block; }
.dot.blue { background:#4c72d6; }
.dot.amber { background:#d89a15; }
.dot.green { background:#1f8c62; }
.dot.gray { background:#97a5be; }
@media (max-width: 940px) {
  .kpi-grid { grid-template-columns:repeat(2, minmax(180px, 1fr)); }
  .main-grid, .bottom-grid { grid-template-columns:1fr; }
}
@media (max-width: 840px) { .layout { display:block; } .sidebar { width:100%; } .main { padding: 12px; } .dashboard-header { flex-direction:column; align-items:flex-start; } .dashboard-tools { width:100%; justify-content:flex-start; } .kpi-grid { grid-template-columns:1fr; } }

.order-management-shell { display:flex; flex-direction:column; gap:20px; }
.order-toolbar { display:flex; align-items:center; justify-content:space-between; }
.filter-pills { display:flex; flex-wrap:wrap; gap:10px; }
.filter-pill { display:inline-flex; align-items:center; gap:8px; padding:8px 12px; border-radius:10px; border:1px solid var(--line); background:#f8faff; color:var(--text); text-decoration:none; font-weight:700; }
.filter-pill span { display:inline-flex; min-width:22px; justify-content:center; align-items:center; padding:2px 6px; border-radius:999px; background:#edf3ff; color:var(--primary); font-size:0.72rem; }
.filter-pill.active { background:var(--primary); color:#fff; border-color:var(--primary); }
.filter-pill.active span { background:rgba(255,255,255,0.16); color:#fff; }
.order-form-panel, .order-table-panel { background:#fff; border:1px solid var(--line); border-radius:16px; box-shadow:var(--shadow); padding:18px; }
.order-form-panel h3 { margin:0 0 14px; font-size:1.2rem; }
.order-form-grid { gap:14px; }
.order-form-grid > div { flex:1; }
.compact-grid { align-items:end; }
.order-form textarea { min-height:72px; resize:vertical; }
.order-form-actions { display:flex; justify-content:flex-end; margin-top:8px; }
.panel-head { display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:14px; }
.panel-head h3 { margin:0; }
.order-table { width:100%; border-collapse:collapse; }
.order-table th, .order-table td { padding:12px 10px; border-bottom:1px solid var(--line); text-align:left; vertical-align:top; }
.order-table th { background:#f9fbff; color:var(--muted); font-size:0.78rem; letter-spacing:0.06em; text-transform:uppercase; }
.mono { font-family: Consolas, 'Courier New', monospace; font-weight:700; }
.date-block { display:flex; flex-direction:column; gap:3px; }
.date-block small { color:var(--muted); }
.customer-cell { display:flex; align-items:center; gap:10px; }
.customer-avatar { width:32px; height:32px; border-radius:50%; background:linear-gradient(135deg, #eff4ff, #dfe9ff); color:var(--primary); display:inline-flex; align-items:center; justify-content:center; font-weight:800; }
.customer-cell strong, .customer-cell small { display:block; }
.customer-cell small { color:var(--muted); }
.inline-action-form { display:flex; align-items:center; gap:8px; }
.quick-status { border:1px solid var(--line); background:#f9fbff; border-radius:8px; padding:8px 10px; min-width:140px; }
.tiny-btn { border:none; background:var(--primary); color:#fff; border-radius:8px; padding:8px 10px; font-weight:700; cursor:pointer; }
.customer-shell { display:flex; flex-direction:column; gap:20px; }
.customer-header-panel { background:rgba(255,255,255,0.65); border:1px solid rgba(255,255,255,0.35); border-radius:16px; padding:20px 18px; box-shadow:var(--shadow); }
.customer-header-main { display:flex; justify-content:space-between; align-items:center; gap:12px; }
.section-label { color:var(--muted); font-size:0.76rem; text-transform:uppercase; letter-spacing:0.1em; }
.customer-title-wrap h2 { margin:8px 0 0; font-size:2rem; }
.customer-profile-card { background:#fff; border:1px solid var(--line); border-radius:16px; padding:20px 18px; display:flex; align-items:center; justify-content:space-between; gap:16px; box-shadow:var(--shadow); }
.profile-identity { display:flex; align-items:center; gap:18px; }
.customer-avatar-large { width:70px; height:70px; border-radius:18px; background:linear-gradient(135deg, #d9e9c8, #b8d7a7); color:#2d5633; display:flex; align-items:center; justify-content:center; font-size:2rem; font-weight:800; }
.profile-badge { display:inline-flex; align-items:center; padding:7px 12px; border-radius:999px; font-size:0.8rem; font-weight:700; }
.profile-badge.success { background:#e8f8ee; color:#1c7d52; }
.profile-meta-grid { display:flex; gap:30px; }
.meta-field { display:flex; flex-direction:column; gap:6px; color:var(--muted); font-size:0.8rem; }
.meta-field strong { color:var(--text); font-size:0.86rem; }
.customer-tabs { display:flex; gap:8px; flex-wrap:wrap; border-bottom:1px solid var(--line); padding-bottom:10px; }
.customer-tabs button { background:transparent; border:none; color:var(--muted); padding:10px 14px; font-size:1rem; font-weight:700; border-radius:8px 8px 0 0; cursor:pointer; }
.customer-tabs button.active { color:var(--primary); border-bottom:2px solid var(--primary); }
.details-grid { display:grid; grid-template-columns:1.5fr 1fr; gap:18px; }
.detail-panel { background:#fff; border:1px solid var(--line); border-radius:16px; padding:18px; box-shadow:var(--shadow); }
.detail-panel h3 { margin:0 0 16px; font-size:1.1rem; }
.property-list { display:flex; flex-direction:column; gap:12px; }
.property-row { display:grid; grid-template-columns:140px 1fr; gap:10px; align-items:center; padding:12px 0; border-bottom:1px solid var(--line); }
.property-label { color:var(--muted); font-weight:700; }
.property-value { font-weight:600; }
.summary-list { display:flex; flex-direction:column; gap:12px; }
.summary-item { display:flex; justify-content:space-between; align-items:center; gap:10px; padding:12px 0; border-bottom:1px solid var(--line); }
.summary-item strong { display:block; }
.summary-item small { color:var(--muted); display:block; margin-top:3px; }
.summary-item span { font-weight:800; color:var(--primary); }
.customer-form-panel { background:#fff; border:1px solid var(--line); border-radius:16px; padding:18px; box-shadow:var(--shadow); }
.customer-form-panel h3 { margin:0 0 14px; }
.customer-form textarea { min-height:90px; }
.customer-form-grid { gap:14px; }
.form-actions { display:flex; justify-content:flex-end; margin-top:12px; }
.tracking-shell { display:flex; flex-direction:column; gap:22px; }
.tracking-card { background:#f4f3f4; border:1px solid #e7e1e4; border-radius:28px; padding:26px 28px 22px; box-shadow:0 16px 30px rgba(33, 34, 38, 0.08); }
.tracking-header { display:flex; flex-direction:column; gap:10px; }
.tracking-badge { display:inline-flex; align-items:center; width:max-content; font-size:0.9rem; font-weight:800; letter-spacing:0.16em; text-transform:uppercase; color:#333; }
.tracking-title { font-size:3rem; font-weight:800; line-height:1.1; letter-spacing:-0.04em; max-width:720px; }
.progress-track { display:grid; grid-template-columns:repeat(6, minmax(48px, 1fr)); gap:16px; align-items:center; margin-top:32px; position:relative; }
.progress-track::before { content:""; position:absolute; left:0; right:0; top:13px; height:4px; background:#d9d9d9; border-radius:999px; }
.step { position:relative; z-index:1; display:flex; justify-content:center; }
.step span { width:22px; height:22px; border-radius:50%; background:#d9d9d9; display:block; box-shadow:0 0 0 6px #f4f3f4; }
.step.done span, .step.active span { background:#ee7aa7; }
.step.active span { box-shadow:0 0 0 6px #f4f3f4, 0 0 0 12px rgba(238,122,167,0.18); }
.progress-labels { display:grid; grid-template-columns:repeat(6, minmax(48px, 1fr)); gap:16px; margin-top:12px; font-size:.9rem; color:#555; text-align:center; }
.progress-labels .current { font-weight:700; color:#1e1e1e; }
.tracking-meta { margin-top:34px; }
.meta-label { font-size:0.95rem; letter-spacing:0.22em; text-transform:uppercase; color:#555; }
.meta-value { margin-top:10px; font-size:1.1rem; }
.tracking-details { margin-top:22px; display:flex; flex-direction:column; gap:18px; }
.detail-row { display:flex; align-items:center; gap:16px; font-size:2rem; font-weight:700; letter-spacing:-0.04em; }
.detail-row .icon { font-size:2rem; }
.tracking-summary { margin-top:28px; display:flex; align-items:center; justify-content:space-between; gap:16px; background:#1f4c4d; color:#fff; border-radius:16px; padding:18px 22px; }
.summary-tag { font-size:0.8rem; letter-spacing:0.2em; text-transform:uppercase; font-weight:700; }
.summary-counter { font-size:2.5rem; font-weight:800; letter-spacing:-0.06em; display:flex; align-items:center; gap:12px; }
.summary-counter span { font-size:1.2rem; letter-spacing:0.02em; font-weight:700; }
.summary-icon { width:52px; height:52px; border-radius:12px; background:rgba(255,255,255,0.12); display:flex; align-items:center; justify-content:center; font-size:1.6rem; }
.tracking-action { display:flex; justify-content:center; }
.new-order-btn { background:transparent; border:2px solid #1d1d1d; border-radius:18px; padding:22px 42px; font-size:1.6rem; font-weight:800; letter-spacing:0.06em; text-transform:uppercase; cursor:pointer; }
.notification-panel { background:#fff; border:1px solid var(--line); border-radius:16px; padding:18px; box-shadow:var(--shadow); }
.notification-panel h3 { margin:0 0 14px; }
.notification-form textarea { min-height:90px; }
.notification-list { display:flex; flex-direction:column; gap:12px; margin-top:18px; }
.notification-item { display:flex; gap:12px; align-items:flex-start; padding:12px; border:1px solid var(--line); border-radius:12px; background:#f9fbff; }
.notification-tag { display:inline-flex; align-items:center; justify-content:center; min-width:54px; padding:6px 8px; border-radius:999px; font-size:0.72rem; font-weight:700; }
.notification-tag.unread { background:#ffe8eb; color:#ba4a5e; }
.notification-tag.read { background:#e9f7ef; color:#1f7d54; }
.notification-body strong, .notification-body small, .notification-body p { display:block; }
.notification-body small { color:var(--muted); margin:4px 0; }
.notification-body p { margin:0; color:var(--text); }
.toast-region { position:fixed; z-index:1000; top:20px; right:20px; width:min(420px, calc(100vw - 32px)); display:grid; gap:10px; pointer-events:none; }
.toast { pointer-events:auto; display:grid; grid-template-columns:32px 1fr 30px; gap:12px; align-items:start; padding:14px; border:1px solid var(--line); border-left:4px solid var(--info); border-radius:12px; background:#fff; box-shadow:0 12px 32px rgba(20,35,55,.18); animation:toast-enter .2s ease-out; }
.toast-success { border-left-color:var(--success); }
.toast-error { border-left-color:var(--danger); }
.toast-warning { border-left-color:var(--warning); }
.toast-information { border-left-color:var(--info); }
.toast-icon { width:28px; height:28px; display:grid; place-items:center; border-radius:50%; background:#edf3ff; color:var(--info); font-weight:800; }
.toast-success .toast-icon { background:#e9f8ef; color:var(--success); }
.toast-error .toast-icon { background:#fff0ef; color:var(--danger); }
.toast-warning .toast-icon { background:#fff5df; color:#946500; }
.toast p { margin:3px 0 0; line-height:1.45; }
.toast-close { color:var(--muted); background:transparent; padding:0; font-size:1.35rem; line-height:1; }
.toast-leaving { opacity:0; transform:translateX(12px); transition:opacity .2s ease, transform .2s ease; }
@keyframes toast-enter { from { opacity:0; transform:translateY(-8px); } to { opacity:1; transform:translateY(0); } }

.confirm-overlay { position:fixed; z-index:1100; inset:0; display:grid; place-items:center; padding:18px; background:rgba(13,25,42,.48); backdrop-filter:blur(2px); }
.confirm-overlay[hidden] { display:none !important; }
.confirm-dialog { width:min(460px, 100%); background:#fff; border:1px solid var(--line); border-radius:18px; padding:24px; box-shadow:0 24px 70px rgba(13,25,42,.28); }
.confirm-icon { width:40px; height:40px; display:grid; place-items:center; border-radius:50%; background:#fff5df; color:#986600; font-weight:900; }
.confirm-icon.destructive { background:#ffe8eb; color:var(--danger); }
.confirm-dialog h2 { margin:14px 0 8px; font-size:1.25rem; }
.confirm-dialog p { margin:0; color:var(--muted); line-height:1.5; }
.confirm-actions { display:flex; justify-content:flex-end; gap:10px; margin-top:24px; }
.confirm-cancel { background:#eef2f8; color:var(--text); border:1px solid var(--line); }
.confirm-cancel:hover { background:#e2e8f0; }
.confirm-accept.destructive { background:var(--danger); }
.confirm-accept.destructive:hover { background:#9c2f2f; }
body.dialog-open { overflow:hidden; }

form.show-validation :invalid { border-color:var(--danger); box-shadow:0 0 0 2px rgba(191,59,59,.12); }
.field-error { display:block; margin:-10px 0 12px; color:var(--danger); font-size:.8rem; font-weight:600; }
[aria-invalid="true"] { border-color:var(--danger) !important; box-shadow:0 0 0 2px rgba(191,59,59,.12); }
.empty-state { padding:24px; text-align:center; color:var(--muted); background:#f9fbff; border:1px dashed #cfd8e6; border-radius:12px; }
.empty-state strong, .empty-state h3 { color:var(--text); }
.empty-state p { margin:8px 0 14px; }
button:disabled { opacity:.65; cursor:wait; }

@media (max-width: 840px) {
  .filter-pills { overflow-x:auto; flex-wrap:nowrap; }
  .row.order-form-grid { display:block; }
  .order-table { min-width:760px; }
  .details-grid { grid-template-columns:1fr; }
  .customer-profile-card { flex-direction:column; align-items:flex-start; }
  .property-row { grid-template-columns:1fr; }
  .tracking-title { font-size:2.1rem; }
  .detail-row { font-size:1.2rem; }
  .summary-counter { font-size:1.5rem; }
  .tracking-summary { flex-direction:column; align-items:flex-start; }
}

@media (max-width: 600px) {
  .toast-region { top:10px; right:10px; width:calc(100vw - 20px); }
  .confirm-dialog { padding:20px; }
  .confirm-actions button { flex:1; }
  .progress-track, .progress-labels { gap:6px; }
  .progress-labels { font-size:.68rem; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration:.01ms !important; transition-duration:.01ms !important; scroll-behavior:auto !important; }
}

.auth-page { min-height:100vh; background:#fff; font-family:Arial, Helvetica, sans-serif; }
.auth-layout { min-height:100vh; display:grid; grid-template-columns:minmax(0, .94fr) minmax(0, 1.06fr); }
.auth-brand-panel { min-height:100vh; position:relative; isolation:isolate; display:flex; flex-direction:column; overflow:hidden; padding:clamp(34px, 5vw, 72px); color:#fff; background:#102a43; }
.auth-brand-panel::before, .auth-brand-panel::after { content:""; position:absolute; z-index:-1; border-radius:50%; pointer-events:none; }
.auth-brand-panel::before { width:540px; height:540px; right:-280px; top:-230px; border:1px solid rgba(183,211,239,.12); box-shadow:0 0 0 45px rgba(183,211,239,.025), 0 0 0 92px rgba(183,211,239,.02); }
.auth-brand-panel::after { width:360px; height:360px; left:-240px; bottom:-210px; background:rgba(55,111,169,.13); }
.auth-brand { display:inline-flex; align-items:center; gap:13px; width:max-content; color:#fff; text-decoration:none; }
.auth-brand-mark { width:46px; height:46px; flex:0 0 auto; display:grid; place-items:center; border-radius:14px; background:#3476b5; box-shadow:inset 0 1px 0 rgba(255,255,255,.2); }
.auth-brand-mark > span { width:24px; height:24px; position:relative; border:2px solid rgba(255,255,255,.94); border-radius:50%; }
.auth-brand-mark > span::before, .auth-brand-mark > span::after { content:""; position:absolute; border:1.5px solid rgba(255,255,255,.82); border-radius:50%; }
.auth-brand-mark > span::before { inset:3px; }
.auth-brand-mark > span::after { width:4px; height:4px; top:-5px; right:-5px; background:#b9daf5; border:0; }
.auth-brand-name { color:#fff; font-size:1.04rem; letter-spacing:.01em; }
.auth-brand-name strong { font-weight:700; }
.auth-brand-copy { position:relative; z-index:2; max-width:440px; margin:auto 0; padding:34px 0 178px; }
.auth-kicker { display:inline-flex; align-items:center; gap:9px; color:#aac7e2; font-size:.72rem; font-weight:700; letter-spacing:.16em; }
.auth-kicker > span { width:7px; height:7px; border-radius:50%; background:#7ab8ea; box-shadow:0 0 0 4px rgba(122,184,234,.12); }
.auth-brand-copy h1 { margin:22px 0 18px; font-size:clamp(2.7rem, 4.2vw, 4rem); line-height:1.06; letter-spacing:-.055em; font-weight:700; }
.auth-brand-copy p { max-width:390px; margin:0; color:#c2d1df; font-size:1rem; line-height:1.75; }
.auth-brand-footer { position:relative; z-index:2; display:flex; align-items:center; gap:12px; color:#aabed1; font-size:.8rem; }
.footer-rule { width:26px; height:1px; background:#6d93b5; }
.laundry-art { width:400px; height:300px; position:absolute; right:3%; bottom:58px; z-index:1; }
.art-orbit { position:absolute; border:1px solid rgba(185,215,242,.12); border-radius:50%; }
.art-orbit-one { width:330px; height:330px; right:8px; bottom:-94px; }
.art-orbit-two { width:250px; height:250px; right:48px; bottom:-54px; }
.art-machine { position:absolute; right:54px; bottom:16px; width:214px; height:215px; padding:17px 18px; border:1px solid rgba(255,255,255,.8); border-radius:20px; background:linear-gradient(145deg,#f9fcff,#dce8f1); box-shadow:0 22px 50px rgba(3,17,31,.27), inset 0 2px 3px #fff; transform:rotate(2deg); }
.machine-top { height:24px; display:flex; align-items:center; gap:9px; border-bottom:1px solid #d5e0e9; }
.machine-brand-dot { width:7px; height:7px; border-radius:50%; background:#6b9dc7; }
.machine-display { width:50px; height:10px; border-radius:4px; background:#c7d7e5; }
.machine-knob { width:16px; height:16px; margin-left:auto; border:2px solid #aebfce; border-radius:50%; background:#edf4f9; }
.machine-door { width:124px; height:124px; display:grid; place-items:center; margin:15px auto 0; border:8px solid #d2e0eb; border-radius:50%; background:#b6d2e5; box-shadow:inset 0 0 0 2px #f7fbff, 0 2px 5px rgba(17,42,66,.14); }
.machine-door span { width:84px; height:84px; position:relative; overflow:hidden; border:4px solid #8eafc7; border-radius:50%; background:linear-gradient(145deg,#d9ebf6,#8bb2ce); }
.machine-door span::before { content:""; position:absolute; width:115px; height:54px; left:-16px; bottom:-20px; border-radius:50%; background:#eef7fc; transform:rotate(-12deg); }
.machine-door span::after { content:""; position:absolute; width:72px; height:30px; right:-7px; top:13px; border-radius:50%; background:rgba(255,255,255,.28); transform:rotate(-34deg); }
.art-towel { position:absolute; left:22px; bottom:15px; width:112px; height:42px; border-radius:10px 10px 7px 7px; background:#d5e4ef; box-shadow:0 8px 18px rgba(4,21,38,.16); transform:rotate(-7deg); }
.art-towel::before { content:""; position:absolute; inset:8px 12px; border-top:1px solid rgba(82,121,153,.28); border-bottom:1px solid rgba(82,121,153,.2); }
.art-towel-front { left:3px; bottom:51px; width:112px; height:38px; background:#f2f7fb; transform:rotate(5deg); }
.art-towel-front::before { inset:8px 14px; }
.art-spark { position:absolute; color:#b9d9f2; font-size:23px; }
.art-spark-one { top:49px; left:66px; }
.art-spark-two { top:101px; right:15px; font-size:18px; }
.art-bubble { position:absolute; border:1px solid rgba(188,220,246,.48); border-radius:50%; background:rgba(171,209,238,.1); }
.art-bubble-one { width:17px; height:17px; top:57px; right:93px; }
.art-bubble-two { width:10px; height:10px; top:95px; left:116px; }
.auth-form-panel { min-width:0; position:relative; display:flex; align-items:center; justify-content:center; padding:64px clamp(28px, 7vw, 104px) 86px; background:#fff; }
.auth-form-wrap { width:min(100%, 430px); }
.auth-mobile-brand { display:none; }
.auth-form-heading { margin-bottom:33px; }
.auth-form-eyebrow { color:#56769a; font-size:.72rem; font-weight:700; letter-spacing:.16em; }
.auth-form-heading h2 { margin:13px 0 9px; color:#17283b; font-size:2.25rem; line-height:1.15; letter-spacing:-.045em; }
.auth-form-heading p { margin:0; color:#6d7d90; font-size:.96rem; line-height:1.6; }
.auth-form { display:flex; flex-direction:column; gap:20px; }
.auth-field { margin:0; }
.auth-field label { display:block; margin-bottom:8px; color:#293a4d; font-size:.86rem; font-weight:700; }
.auth-field > input, .auth-password-wrap input { width:100%; height:52px; margin:0; padding:0 15px; border:1px solid #dbe3eb; border-radius:10px; outline:none; background:#fbfcfe; color:#1d2636; font:inherit; font-size:.94rem; box-shadow:0 1px 2px rgba(21,42,65,.02); transition:border-color .18s ease, box-shadow .18s ease, background .18s ease; }
.auth-field input::placeholder { color:#9aa8b7; }
.auth-field > input:hover, .auth-password-wrap input:hover { border-color:#b9c9d8; background:#fff; }
.auth-field > input:focus, .auth-password-wrap input:focus { border-color:#3979b7; background:#fff; box-shadow:0 0 0 4px rgba(57,121,183,.12); }
.auth-password-wrap { position:relative; }
.auth-password-wrap input { padding-right:68px; }
.auth-password-toggle { position:absolute; top:50%; right:12px; padding:6px; transform:translateY(-50%); border:0; border-radius:6px; background:transparent; color:#527ba0; font-size:.79rem; font-weight:700; }
.auth-password-toggle:hover { background:#edf4fa; color:#214a80; }
.auth-options { display:flex; align-items:center; justify-content:space-between; margin-top:-1px; }
.auth-remember { display:inline-flex; align-items:center; gap:9px; margin:0; color:#526478; font-size:.85rem; font-weight:500; cursor:pointer; }
.auth-remember input { width:17px; height:17px; margin:0; accent-color:#2d6eaa; cursor:pointer; }
.auth-submit { width:100%; min-height:52px; display:flex; align-items:center; justify-content:center; gap:10px; margin-top:3px; border:1px solid #214a80; border-radius:10px; background:#214a80; color:#fff; font:inherit; font-size:.94rem; font-weight:700; letter-spacing:.01em; box-shadow:0 5px 12px rgba(33,74,128,.15); transition:background .18s ease, border-color .18s ease, transform .18s ease, box-shadow .18s ease; }
.auth-submit:hover { border-color:#173b69; background:#173b69; box-shadow:0 8px 18px rgba(33,74,128,.2); transform:translateY(-1px); }
.auth-submit:focus-visible, .auth-password-toggle:focus-visible, .auth-remember input:focus-visible { outline:3px solid rgba(58,126,185,.36); outline-offset:3px; }
.auth-submit:disabled { transform:none; }
.auth-submit-arrow { font-size:1.15rem; font-weight:400; }
.auth-security-note { display:flex; align-items:center; justify-content:center; gap:9px; margin-top:27px; color:#7a8998; }
.auth-security-note p { margin:0; font-size:.77rem; }
.auth-lock-icon { width:14px; height:11px; position:relative; margin-top:5px; border:1.5px solid #8494a4; border-radius:3px; }
.auth-lock-icon::before { content:""; width:7px; height:7px; position:absolute; left:2px; top:-7px; border:1.5px solid #8494a4; border-bottom:0; border-radius:6px 6px 0 0; }
.auth-copyright { position:absolute; right:clamp(28px, 7vw, 104px); bottom:26px; margin:0; color:#98a5b2; font-size:.73rem; }
.auth-page .toast-region { position:relative; inset:auto; width:100%; display:grid; gap:9px; margin:-13px 0 22px; pointer-events:auto; }
.auth-page .toast { grid-template-columns:28px 1fr 28px; padding:12px; border-radius:10px; box-shadow:0 5px 16px rgba(20,35,55,.08); }
.auth-page .toast p { font-size:.85rem; }
.auth-page .toast-close { min-height:28px; }
.auth-page .field-error { margin:7px 0 0; }
.auth-page [aria-invalid="true"] { border-color:var(--danger) !important; }
@media (max-width:980px) {
  .auth-layout { grid-template-columns:minmax(0, .88fr) minmax(0, 1.12fr); }
  .auth-brand-panel { padding:34px; }
  .auth-form-panel { padding-right:42px; padding-left:42px; }
  .laundry-art { right:-82px; transform:scale(.88); transform-origin:bottom right; }
}
@media (max-width:760px) {
  .auth-layout { display:flex; flex-direction:column; }
  .auth-brand-panel { min-height:340px; padding:26px 30px; }
  .auth-brand-copy { max-width:390px; margin:auto 0; padding:34px 0 18px; }
  .auth-brand-copy h1 { margin:17px 0 11px; font-size:2.65rem; }
  .auth-brand-copy p { max-width:360px; font-size:.9rem; line-height:1.6; }
  .auth-brand-footer { display:none; }
  .laundry-art { right:-50px; bottom:-28px; opacity:.34; transform:scale(.76); transform-origin:bottom right; }
  .auth-form-panel { min-height:560px; align-items:flex-start; padding:50px 28px 78px; }
  .auth-form-wrap { max-width:440px; margin:0 auto; }
  .auth-form-heading h2 { font-size:2rem; }
  .auth-copyright { right:28px; bottom:22px; }
}
@media (max-width:480px) {
  .auth-brand-panel { min-height:300px; padding:22px 22px 25px; }
  .auth-brand-mark { width:40px; height:40px; border-radius:12px; }
  .auth-brand-copy { padding-top:30px; }
  .auth-brand-copy h1 { font-size:2.25rem; }
  .auth-brand-copy p { max-width:310px; font-size:.84rem; }
  .auth-kicker { font-size:.65rem; }
  .laundry-art { right:-110px; bottom:-49px; opacity:.24; transform:scale(.65); }
  .auth-form-panel { min-height:535px; padding:38px 22px 72px; }
  .auth-mobile-brand { display:flex; align-items:center; gap:11px; margin-bottom:37px; }
  .auth-mobile-brand .auth-brand-mark { width:38px; height:38px; }
  .auth-mobile-brand .auth-brand-mark > span { transform:scale(.88); }
  .auth-mobile-brand .auth-brand-name { color:#17324e; font-size:.94rem; }
  .auth-form-heading { margin-bottom:27px; }
  .auth-form-heading h2 { margin-top:10px; font-size:1.85rem; }
  .auth-form { gap:17px; }
  .auth-field > input, .auth-password-wrap input { height:50px; }
  .auth-security-note { margin-top:23px; }
}
@media (prefers-reduced-motion: reduce) {
  .auth-field > input, .auth-password-wrap input, .auth-submit { transition:none; }
}

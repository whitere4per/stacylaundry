/* Stacey Laundry Hub - Customer Portal (Modern Top-Bar Card Layout, Green & White) */
:root {
  --cp-outer-bg: #f1f5f3;
  --cp-surface: #ffffff;
  --cp-primary: #15803d;
  --cp-primary-dark: #166534;
  --cp-primary-bright: #16a34a;
  --cp-primary-soft: #dcfce7;
  --cp-primary-tint: #f0fdf4;
  --cp-text: #111827;
  --cp-muted: #6b7280;
  --cp-line: #e5e7eb;
  --cp-danger: #dc2626;
  --cp-danger-soft: #fef2f2;
  --cp-warning: #d97706;
  --cp-warning-soft: #fffbeb;
  --cp-info: #0284c7;
  --cp-info-soft: #f0f9ff;
  --cp-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
  --cp-card-shadow: 0 4px 16px rgba(15, 23, 42, 0.05);
  --cp-radius: 18px;
}

*, *::before, *::after { box-sizing: border-box; }

body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  background: var(--cp-outer-bg);
  color: var(--cp-text);
  line-height: 1.5;
  padding: 22px 16px 40px;
}

a { color: var(--cp-primary); text-decoration: none; }
a:hover { text-decoration: none; }

/* --- Centered Application Shell (Reference Layout) --- */
.cp-shell {
  max-width: 1080px;
  margin: 0 auto;
  background: var(--cp-surface);
  border-radius: 22px;
  box-shadow: var(--cp-shadow);
  overflow: hidden;
  border: 1px solid rgba(229, 231, 235, 0.8);
}

/* --- Top Brand Header --- */
.cp-header {
  background: linear-gradient(135deg, #15803d 0%, #16a34a 100%);
  padding: 16px 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.cp-brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: #ffffff;
  font-size: 1.15rem;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.cp-brand-badge {
  width: 36px;
  height: 36px;
  border-radius: 11px;
  background: #ffffff;
  color: var(--cp-primary-dark);
  display: grid;
  place-items: center;
  font-weight: 900;
  font-size: 0.95rem;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
}

.cp-header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.cp-pill-white {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  border-radius: 999px;
  background: #ffffff;
  color: var(--cp-primary-dark);
  font-size: 0.84rem;
  font-weight: 700;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  transition: transform 0.12s ease, background 0.15s ease;
}

.cp-pill-white:hover { background: #f0fdf4; transform: translateY(-1px); }

.cp-icon-circle {
  position: relative;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  color: var(--cp-primary-dark);
  display: grid;
  place-items: center;
  font-size: 1rem;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  transition: transform 0.12s ease;
}

.cp-icon-circle:hover { transform: translateY(-1px); background: #ffffff; }

.cp-icon-circle.accent {
  background: #0f291e;
  color: #ffffff;
}

.cp-bell-count {
  position: absolute;
  top: -4px;
  right: -4px;
  min-width: 18px;
  height: 18px;
  padding: 0 5px;
  border-radius: 999px;
  background: #ef4444;
  color: #ffffff;
  font-size: 0.68rem;
  font-weight: 800;
  display: grid;
  place-items: center;
  border: 2px solid #ffffff;
}

.cp-user-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 4px 12px 4px 4px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 0.86rem;
  font-weight: 600;
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.cp-user-chip:hover { background: rgba(255, 255, 255, 0.28); }
.cp-user-chip > span:last-child { max-width: 110px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.cp-avatar-sm {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: #ffffff;
  color: var(--cp-primary-dark);
  display: grid;
  place-items: center;
  font-size: 0.8rem;
  font-weight: 800;
  overflow: hidden;
}

.cp-avatar-sm img { width: 100%; height: 100%; object-fit: cover; }

/* --- Sub Navigation Strip --- */
.cp-subnav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 10px 28px;
  background: #f8faf9;
  border-bottom: 1px solid var(--cp-line);
  overflow-x: auto;
}

.cp-subnav-links {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-wrap: nowrap;
}

.cp-subnav-links a {
  padding: 6px 12px;
  border-radius: 999px;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--cp-muted);
  white-space: nowrap;
  transition: background 0.15s ease, color 0.15s ease;
}

.cp-subnav-links a:hover {
  background: var(--cp-primary-soft);
  color: var(--cp-primary-dark);
}

.cp-subnav-links a.active {
  background: var(--cp-primary);
  color: #ffffff;
}

.cp-subnav-links a.cp-logout-link {
  color: var(--cp-danger);
}

.cp-subnav-links a.cp-logout-link:hover {
  background: var(--cp-danger-soft);
}

.cp-menu-btn {
  display: none;
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.35);
  border-radius: 999px;
  padding: 6px 12px;
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
}

/* --- Main Content --- */
.cp-content {
  padding: 30px 36px 36px;
}

.cp-greeting {
  margin: 0 0 22px;
  font-size: 2rem;
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--cp-text);
}

/* --- Hero Action Card (Reference Style) --- */
.cp-hero-card {
  background: #ffffff;
  border: 1px solid var(--cp-line);
  border-radius: 18px;
  padding: 22px 24px;
  box-shadow: var(--cp-card-shadow);
  margin-bottom: 28px;
}

.cp-hero-card h2 {
  margin: 0 0 4px;
  font-size: 1.15rem;
  font-weight: 600;
}

.cp-hero-card p {
  margin: 0 0 18px;
  font-size: 0.86rem;
  color: var(--cp-muted);
}

.cp-pill-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 13px 22px;
  border-radius: 999px;
  background: var(--cp-primary);
  color: #ffffff;
  font-size: 0.92rem;
  font-weight: 700;
  transition: background 0.15s ease, transform 0.12s ease;
}

.cp-pill-cta:hover {
  background: var(--cp-primary-dark);
  color: #ffffff;
  transform: translateY(-1px);
}

/* --- Compact KPI Strip --- */
.cp-grid-5 {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 28px;
}

.cp-grid-2 {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.cp-grid-3 {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.cp-kpi {
  background: #f9fbfa;
  border: 1px solid var(--cp-line);
  border-radius: 14px;
  padding: 14px 16px;
}

.cp-kpi.highlight {
  background: var(--cp-primary-tint);
  border-color: #86efac;
}

.cp-kpi-label {
  font-size: 0.74rem;
  font-weight: 700;
  color: var(--cp-muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.cp-kpi-val {
  margin-top: 6px;
  font-size: 1.35rem;
  font-weight: 800;
  color: var(--cp-text);
}

.cp-kpi.highlight .cp-kpi-val { color: var(--cp-primary-dark); }

/* --- Section Headings & Order Rows (Reference Style) --- */
.cp-section-title {
  margin: 0 0 14px;
  font-size: 1.4rem;
  font-weight: 500;
  color: var(--cp-text);
}

.cp-order-rows {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 16px;
}

.cp-order-row {
  display: grid;
  grid-template-columns: 2fr 1.2fr 1fr auto;
  align-items: center;
  gap: 16px;
  padding: 14px 16px;
  border-radius: 14px;
  border: 1px solid var(--cp-line);
  background: #ffffff;
  transition: box-shadow 0.15s ease, border-color 0.15s ease;
}

.cp-order-row:hover {
  border-color: #bbf7d0;
  box-shadow: var(--cp-card-shadow);
}

.cp-order-main {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
}

.cp-order-icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: var(--cp-primary-tint);
  border: 1px solid #bbf7d0;
  color: var(--cp-primary-dark);
  display: grid;
  place-items: center;
  font-size: 1.2rem;
  flex-shrink: 0;
}

.cp-order-meta small,
.cp-order-col small {
  display: block;
  font-size: 0.74rem;
  color: var(--cp-muted);
}

.cp-order-meta strong,
.cp-order-col strong {
  font-size: 0.94rem;
  font-weight: 600;
  color: var(--cp-text);
}

.cp-arrow-circle {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--cp-primary);
  color: #ffffff;
  display: grid;
  place-items: center;
  font-size: 1rem;
  font-weight: 700;
  transition: background 0.15s ease, transform 0.12s ease;
}

.cp-arrow-circle:hover {
  background: var(--cp-primary-dark);
  color: #ffffff;
  transform: translateX(2px);
}

.cp-pill-muted {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 14px;
  border-radius: 999px;
  background: #f1f5f9;
  color: #334155;
  font-size: 0.74rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  margin-bottom: 28px;
}

.cp-pill-muted:hover { background: #e2e8f0; color: #0f172a; }

/* --- Quick Links Bar (Reference Style) --- */
.cp-quick-links {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
}

.cp-quick-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 9px 16px;
  border-radius: 999px;
  border: 1px solid var(--cp-line);
  background: #ffffff;
  color: var(--cp-text);
  font-size: 0.84rem;
  font-weight: 600;
  transition: border-color 0.15s ease, background 0.15s ease;
}

.cp-quick-pill:hover {
  border-color: var(--cp-primary);
  background: var(--cp-primary-tint);
  color: var(--cp-primary-dark);
}

/* --- Standard Cards, Tables, Forms --- */
.cp-card {
  background: #ffffff;
  border: 1px solid var(--cp-line);
  border-radius: 16px;
  padding: 22px;
  box-shadow: var(--cp-card-shadow);
  margin-bottom: 20px;
}

.cp-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 16px;
}

.cp-card-head h2, .cp-card-head h3 {
  margin: 0;
  font-size: 1.08rem;
  font-weight: 700;
}

.cp-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 9px 16px;
  border-radius: 999px;
  border: 1px solid transparent;
  background: var(--cp-primary);
  color: #ffffff;
  font-size: 0.86rem;
  font-weight: 600;
  cursor: pointer;
}

.cp-btn:hover { background: var(--cp-primary-dark); color: #ffffff; }

.cp-btn-outline {
  background: #ffffff;
  color: var(--cp-text);
  border-color: var(--cp-line);
}

.cp-btn-outline:hover { background: #f8fafc; color: var(--cp-text); }

.cp-btn-sm { padding: 6px 13px; font-size: 0.8rem; }

.cp-form-group { margin-bottom: 14px; }
.cp-form-group label {
  display: block;
  margin-bottom: 5px;
  font-size: 0.84rem;
  font-weight: 600;
}

.cp-input, .cp-select, .cp-textarea {
  width: 100%;
  padding: 9px 12px;
  border: 1px solid #cbd5e1;
  border-radius: 10px;
  font-size: 0.9rem;
  font-family: inherit;
  background: #ffffff;
  color: var(--cp-text);
}

.cp-input:focus, .cp-select:focus, .cp-textarea:focus {
  outline: none;
  border-color: var(--cp-primary);
  box-shadow: 0 0 0 3px rgba(21, 128, 61, 0.14);
}

.cp-filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: flex-end;
  margin-bottom: 18px;
}

.cp-filter-bar > div { flex: 1; min-width: 150px; }

.cp-table-wrap { overflow-x: auto; }
.cp-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.89rem;
}

.cp-table th, .cp-table td {
  padding: 12px 10px;
  border-bottom: 1px solid var(--cp-line);
  text-align: left;
  vertical-align: middle;
}

.cp-table th {
  font-size: 0.74rem;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--cp-muted);
  font-weight: 700;
}

/* --- Badges --- */
.cp-badge {
  display: inline-flex;
  align-items: center;
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 700;
  white-space: nowrap;
}

.cp-badge-green { background: var(--cp-primary-soft); color: var(--cp-primary-dark); }
.cp-badge-blue { background: var(--cp-info-soft); color: #0369a1; }
.cp-badge-amber { background: var(--cp-warning-soft); color: #b45309; }
.cp-badge-red { background: var(--cp-danger-soft); color: var(--cp-danger); }
.cp-badge-gray { background: #f1f5f9; color: #475569; }

/* --- Tracking Timeline --- */
.cp-timeline {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 10px;
  margin: 22px 0;
}

.cp-stage {
  text-align: center;
  padding: 12px 8px;
  border-radius: 12px;
  border: 1px solid var(--cp-line);
  background: #f8fafc;
}

.cp-stage.done { background: var(--cp-primary-tint); border-color: #86efac; }
.cp-stage.active {
  background: var(--cp-primary);
  border-color: var(--cp-primary-dark);
  color: #ffffff;
  box-shadow: 0 8px 20px rgba(21, 128, 61, 0.25);
}

.cp-stage-num {
  width: 28px;
  height: 28px;
  margin: 0 auto 6px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-weight: 800;
  font-size: 0.82rem;
  background: #e2e8f0;
  color: #475569;
}

.cp-stage.done .cp-stage-num { background: var(--cp-primary); color: #ffffff; }
.cp-stage.active .cp-stage-num { background: #ffffff; color: var(--cp-primary-dark); }
.cp-stage-label { font-size: 0.82rem; font-weight: 700; }
.cp-stage-time { font-size: 0.72rem; opacity: 0.85; margin-top: 4px; }

/* --- Notifications & Empty States --- */
.cp-notif-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14px;
  padding: 14px;
  border: 1px solid var(--cp-line);
  border-radius: 14px;
  margin-bottom: 10px;
  background: #ffffff;
}

.cp-notif-item.unread {
  border-left: 4px solid var(--cp-primary);
  background: var(--cp-primary-tint);
}

.cp-empty {
  text-align: center;
  padding: 28px 18px;
  border: 1px dashed #cbd5e1;
  border-radius: 14px;
  background: #f8fafc;
  color: var(--cp-muted);
}

.cp-empty strong { display: block; color: var(--cp-text); margin-bottom: 6px; }

/* --- Auth Pages --- */
body.cp-auth-body { padding: 0; }

.cp-auth-wrap {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
  background: linear-gradient(160deg, #0f291e 0%, #15803d 55%, #f1f5f3 55.2%, #f1f5f3 100%);
}

.cp-auth-card {
  width: min(440px, 100%);
  background: #ffffff;
  border: 1px solid var(--cp-line);
  border-radius: 20px;
  padding: 32px;
  box-shadow: 0 24px 60px rgba(15, 41, 30, 0.22);
}

.cp-auth-header { text-align: center; margin-bottom: 24px; }
.cp-auth-header h1 { margin: 10px 0 6px; font-size: 1.5rem; }
.cp-auth-header p { margin: 0; color: var(--cp-muted); font-size: 0.9rem; }

/* --- Toasts --- */
.cp-toast-region {
  position: fixed;
  top: 18px;
  right: 18px;
  z-index: 1200;
  display: grid;
  gap: 10px;
  width: min(400px, calc(100vw - 24px));
}

.cp-toast {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  padding: 13px 16px;
  border-radius: 12px;
  background: #ffffff;
  border: 1px solid var(--cp-line);
  border-left: 4px solid var(--cp-primary);
  box-shadow: 0 12px 28px rgba(15, 23, 42, 0.14);
  font-size: 0.9rem;
}

.cp-toast.error { border-left-color: var(--cp-danger); }
.cp-toast.warning { border-left-color: var(--cp-warning); }
.cp-toast.information { border-left-color: var(--cp-info); }

.cp-toast-close {
  background: transparent;
  border: 0;
  color: var(--cp-muted);
  font-size: 1.2rem;
  cursor: pointer;
  line-height: 1;
}

/* --- Responsive --- */
@media (max-width: 900px) {
  .cp-grid-5 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .cp-timeline { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}

@media (max-width: 760px) {
  body { padding: 0; background: #ffffff; }
  .cp-shell { border-radius: 0; border: 0; box-shadow: none; }
  .cp-header { padding: 14px 16px; }
  .cp-content { padding: 20px 16px; }
  .cp-menu-btn { display: inline-flex; }
  .cp-pill-white { display: none; }
  .cp-subnav { display: none; padding: 10px 16px; }
  .cp-subnav.open { display: block; }
  .cp-subnav-links { flex-wrap: wrap; }
  .cp-order-row { grid-template-columns: 1fr; gap: 10px; }
  .cp-grid-5, .cp-grid-2, .cp-grid-3 { grid-template-columns: 1fr; }
  .cp-timeline { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media print {
  body { padding: 0; background: #ffffff; }
  .cp-shell { box-shadow: none; border: 0; }
  .cp-header, .cp-subnav, .no-print { display: none !important; }
  .cp-content { padding: 0; }
  .cp-card { box-shadow: none; border: 1px solid #cbd5e1; }
}


/* --- Pink Bubble Auth Theme (Customer Portal Login / Register / Reset) --- */
.cp-pink-wrap {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  display: grid;
  grid-template-columns: 1fr minmax(340px, 440px) 1fr;
  align-items: center;
  gap: 24px;
  padding: 32px 28px;
  background: radial-gradient(circle at 20% 20%, #fff0f6 0%, #ffd6e8 48%, #ffc0dc 100%);
}

.cp-pink-wave-top,
.cp-pink-wave-bottom {
  position: absolute;
  left: 0;
  width: 100%;
  pointer-events: none;
  z-index: 0;
}

.cp-pink-wave-top { top: 0; }
.cp-pink-wave-bottom { bottom: 0; }

.cp-bubble {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.25) 60%, rgba(244, 63, 142, 0.14) 100%);
  box-shadow: inset 0 0 14px rgba(255, 255, 255, 0.85), 0 8px 20px rgba(216, 27, 96, 0.08);
  pointer-events: none;
  z-index: 0;
}

.cp-pink-left {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 16px;
}

.cp-pink-brand-title {
  margin: 12px 0 4px;
  font-size: 2.5rem;
  font-weight: 800;
  line-height: 1.08;
  color: #d81b60;
  font-family: Georgia, "Times New Roman", serif;
  font-style: italic;
  text-shadow: 0 2px 10px rgba(255, 255, 255, 0.9);
}

.cp-pink-brand-sub {
  font-size: 1.5rem;
  font-weight: 700;
  color: #be185d;
  font-family: Georgia, "Times New Roman", serif;
  font-style: italic;
}

.cp-pink-tagline {
  margin-top: 12px;
  font-size: 1.05rem;
  font-weight: 700;
  color: #831843;
}

.cp-pink-card {
  position: relative;
  z-index: 2;
  background: #ffffff;
  border-radius: 26px;
  padding: 34px 30px 28px;
  box-shadow: 0 22px 60px rgba(190, 24, 93, 0.18);
  border: 1px solid rgba(255, 255, 255, 0.9);
}

.cp-pink-badge-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 14px;
}

.cp-pink-badge-row::before,
.cp-pink-badge-row::after {
  content: "";
  flex: 1;
  height: 1px;
  background: #f9a8d4;
}

.cp-pink-pill-badge {
  display: inline-block;
  padding: 8px 26px;
  border-radius: 999px;
  background: #db2777;
  color: #ffffff;
  font-size: 1.05rem;
  font-weight: 700;
  box-shadow: 0 6px 16px rgba(219, 39, 119, 0.28);
}

.cp-pink-subtitle {
  margin: 0 0 22px;
  text-align: center;
  font-size: 0.9rem;
  color: #4b5563;
}

.cp-pink-label {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 6px;
  font-size: 0.85rem;
  font-weight: 700;
  color: #1f2937;
}

.cp-pink-label svg {
  color: #db2777;
  flex-shrink: 0;
}

.cp-pink-input-wrap {
  position: relative;
  margin-bottom: 16px;
}

.cp-pink-input {
  width: 100%;
  padding: 11px 14px;
  border: 1px solid #f3d0e0;
  border-radius: 12px;
  font-size: 0.92rem;
  font-family: inherit;
  color: #111827;
  background: #ffffff;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.cp-pink-input:focus {
  outline: none;
  border-color: #ec4899;
  box-shadow: 0 0 0 3px rgba(236, 72, 153, 0.16);
}

.cp-pink-eye {
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
  background: transparent;
  border: 0;
  color: #6b7280;
  cursor: pointer;
  padding: 4px;
  display: grid;
  place-items: center;
}

.cp-pink-eye:hover { color: #db2777; }

.cp-pink-links {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 4px 0 20px;
  font-size: 0.83rem;
}

.cp-pink-links a {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: #be185d;
  font-weight: 600;
}

.cp-pink-links a:hover { color: #9d174d; text-decoration: underline; }

.cp-pink-submit {
  width: 100%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 13px 20px;
  border: 0;
  border-radius: 999px;
  background: #db2777;
  color: #ffffff;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 10px 24px rgba(219, 39, 119, 0.3);
  transition: background 0.15s ease, transform 0.12s ease, box-shadow 0.15s ease;
}

.cp-pink-submit:hover {
  background: #be185d;
  transform: translateY(-1px);
  box-shadow: 0 14px 28px rgba(219, 39, 119, 0.36);
}

.cp-pink-footer {
  margin-top: 20px;
  padding-top: 16px;
  border-top: 1px solid #fce7f3;
  text-align: center;
  font-size: 0.83rem;
  color: #4b5563;
}

.cp-pink-footer a {
  color: #be185d;
  font-weight: 700;
}

.cp-pink-right {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  padding: 16px;
}

@media (max-width: 960px) {
  .cp-pink-wrap {
    grid-template-columns: 1fr;
    justify-items: center;
    padding: 28px 16px;
  }
  .cp-pink-right { display: none; }
  .cp-pink-left { padding: 0; margin-bottom: 4px; }
  .cp-pink-brand-title { font-size: 2rem; }
  .cp-pink-brand-sub { font-size: 1.25rem; }
  .cp-pink-card { width: min(440px, 100%); }
}
